generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  ADMIN
  SUPPORT_AGENT
  USER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketChannel {
  VOICE
  WEB
  EMAIL
}

enum TicketCategory {
  DELIVERY
  BILLING
  TECHNICAL
  ACCOUNT
  REFUND
  OTHER
}

enum MessageType {
  COMMENT
  STATUS_CHANGE
  INTERNAL_NOTE
  SYSTEM
}

enum NotificationType {
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_ESCALATED
  TICKET_UPDATED
  MESSAGE_RECEIVED
  SYSTEM_ALERT
}

enum UploadSource {
  BROWSER_RECORDING
  FILE_UPLOAD
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ActivityAction {
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_ASSIGNED
  TICKET_ESCALATED
  TICKET_RESOLVED
  TICKET_CLOSED
  MESSAGE_ADDED
  VOICE_UPLOADED
  ANALYSIS_COMPLETED
  NOTIFICATION_SENT
  SETTINGS_UPDATED
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  clerkId       String         @unique
  email         String         @unique
  firstName     String
  lastName      String
  avatarUrl     String?
  isActive      Boolean        @default(true)
  timezone      String         @default("Asia/Colombo")
  preferredLang String         @default("en")
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  roles               UserRole[]       @relation("UserRoleMemberships")
  createdTickets      Ticket[]         @relation("TicketReporter")
  assignedTickets     Ticket[]         @relation("TicketAssignee")
  ticketMessages      TicketMessage[]
  audioUploads        AudioUpload[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  settings            Setting[]
  sentNotifications   Notification[]   @relation("NotificationSender")

}

model Role {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        SystemRole @unique
  description String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users UserRole[] @relation("RoleAssignments")
}

model UserRole {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  roleId     String   @db.ObjectId
  assignedAt DateTime @default(now())

  user User @relation("UserRoleMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation("RoleAssignments", fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Ticket {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  ticketNo         String         @unique
  title            String
  description      String
  category         TicketCategory @default(OTHER)
  channel          TicketChannel  @default(VOICE)
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(MEDIUM)
  urgencyScore     Float          @default(0.5)
  language         String         @default("English")
  intent           String?
  sentiment        String?
  recommendedAction String?

  reporterId String @db.ObjectId
  assigneeId String? @db.ObjectId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?
  dueAt       DateTime?

  reporter User  @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  messages      TicketMessage[]
  audioUploads  AudioUpload[]
  aiAnalyses    AiAnalysis[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([createdAt])
}

model TicketMessage {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  ticketId   String      @db.ObjectId
  senderId   String      @db.ObjectId
  type       MessageType @default(COMMENT)
  content    String
  isInternal Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([senderId])
}

model AudioUpload {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  userId         String       @db.ObjectId
  ticketId       String?      @db.ObjectId
  source         UploadSource @default(FILE_UPLOAD)
  fileName       String
  mimeType       String
  sizeBytes      Int
  durationSec    Int?
  storageProvider String
  storageKey     String       @unique
  publicUrl      String?
  waveform       Json?
  uploadedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket    Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  analyses  AiAnalysis[]

  @@index([userId])
  @@index([ticketId])
  @@index([uploadedAt])
}

model AiAnalysis {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  ticketId          String         @db.ObjectId
  audioUploadId     String         @db.ObjectId
  status            AnalysisStatus @default(PENDING)

  transcript        String
  language          String
  intent            String
  sentiment         String
  urgencyScore      Float
  priority          TicketPriority
  entities          Json
  confidence        Float?
  modelVersion      String?
  rawResponse       Json?
  recommendedAction String
  errorMessage      String?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  processedAt       DateTime?

  ticket      Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  audioUpload AudioUpload @relation(fields: [audioUploadId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([audioUploadId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  userId     String           @db.ObjectId
  ticketId   String?          @db.ObjectId
  senderId   String?          @db.ObjectId
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  readAt     DateTime?
  metadata   Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  sender User?  @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([ticketId])
}

model ActivityLog {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?        @db.ObjectId
  ticketId   String?        @db.ObjectId
  action     ActivityAction
  targetType String
  targetId   String
  summary    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([ticketId])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?  @db.ObjectId
  key         String
  value       Json
  scope       String   @default("user")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([scope, key])
}
